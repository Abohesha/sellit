# Copy to .env for local development. Never commit .env. In production use a secrets manager.
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
APP_DEEP_LINK=sellit://ebay-connected

# Supabase project in an EU region. DATABASE_URL is the Postgres connection string.
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=item-photos

REDIS_URL=redis://localhost:6379

# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# openssl rand -hex 32
STATE_SIGNING_SECRET=

# eBay: sandbox keys first.
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
# Only needed for account-deletion notifications (32-80 chars)
EBAY_VERIFICATION_TOKEN=
EBAY_NOTIFICATION_ENDPOINT=

# Comma list of ids from src/config/marketplaces.json.
# The first launch marketplace is an OPEN DECISION: EBAY_GB here is only a placeholder.
ENABLED_MARKETPLACES=EBAY_GB

# AI provider is an OPEN DECISION. "none" makes draft jobs fail with a clear message.
AI_PROVIDER=none
AI_MODEL=
AI_PRICE_INPUT_USD_PER_MTOK=0
AI_PRICE_OUTPUT_USD_PER_MTOK=0
AI_MAX_ATTEMPTS=3
